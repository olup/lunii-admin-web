    "@ffmpeg/util": "^0.12.2",
    "@legendapp/state": "^1.11.3",
    "@mantine/core": "^9.8.2",
    "@mantine/form": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/modals": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@tabler/icons-react": "^3.53.0",
    "@tanstack/react-query": "5.108.4",
    "jszip": "^3.10.2",
    "posthog-js": "1.454.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tetris": "^0.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.6",
